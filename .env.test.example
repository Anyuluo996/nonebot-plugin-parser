# 测试环境配置模板 —— 复制为 .env.test 后填入本地真实值
# 注意：.env.test 已被 .gitignore 忽略，禁止提交真实凭据
cp .env.test.example .env.test

PORT=8888
LOG_LEVEL=INFO
FASTAPI_RELOAD=false
# 单测/本地验证异步解析 API (tests/others/test_api_tasks.py) 需 fastapi driver
DRIVER=~fastapi

LOCALSTORE_USE_CWD=true

# 测试时禁用全部平台，按需在本地开启
parser_disabled_platforms='["bilibili", "acfun", "youtube", "kuaishou", "twitter", "tiktok", "weibo", "xiaohongshu", "nga"]'
parser_bili_ck="<your_bili_cookie_here>"
parser_bili_video_codes='["avc", "av01"]'
parser_bili_video_quality=80
parser_ytb_ck="<your_ytb_cookie_here>"
parser_pixiv=https://pixivnow-lyart.vercel.app
parser_pixivR18=false
PARSER_PROXY=http://127.0.0.1:xxxxx

# [可选] 抖音登录态 ttwid Cookie: 抖音 PC detail 接口要求登录态凭据 + a_bogus
# 签名配套才放行 (仅其一都返回空 body)。配置后解析器自动算 a_bogus 签名,
# 可恢复实况照片 (live photo) 视频解析; 留空则纯图文仍可正常解析 (走分享页兜底)。
# 注: 仅 ttwid 易被间歇性风控, 推荐改用下方 parser_douyin_cookie 配置完整 Cookie。
parser_douyin_ttwid=""

# [推荐] 抖音完整登录态 Cookie: 比 ttwid 抗风控更强 (含 sessionid/sid_guard 等)。
# 从浏览器 F12 → Network → www.douyin.com → Request Headers → Cookie 整行复制。
# 配置后优先于 parser_douyin_ttwid 生效; 也可用 SUPERUSER 指令 dycookie 热更新。
parser_douyin_cookie=""

# [可选] 抖音安卓 App 详情端点 (aweme.snssdk.com) 设备参数 JSON: 免签名免 Cookie
# 的独立链路, open-api 形态被风控时优先切换。必填 iid/device_id/aid/version_code,
# 从真机/模拟器抓包 detail 请求 query 提取; 设备是个体标识, 不要提交真实值到仓库。
# 留空不启用该形态。
parser_douyin_app_device_profile=""

# [可选] 异步解析 API (POST 提交链接拿任务 ID → GET 轮询结果), 需安装 extras: api
# (uv add "nonebot-plugin-parser[api]")。三项齐备才注册: enabled + token + base_url。
# token 用于 Bearer 鉴权并派生媒体 URL 签名密钥, 生成: openssl rand -hex 32
# base_url 必须是 QQ 协议端(NapCat)所在网络可达的地址; 详见 docs/features/FEATURE_ASYNC_API.md
parser_api_enabled=false
parser_api_token="<your_random_token_here>"
parser_api_base_url=""
