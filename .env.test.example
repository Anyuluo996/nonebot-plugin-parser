# 测试环境配置模板 —— 复制为 .env.test 后填入本地真实值
# 注意：.env.test 已被 .gitignore 忽略，禁止提交真实凭据
cp .env.test.example .env.test

PORT=8888
LOG_LEVEL=INFO
FASTAPI_RELOAD=false

LOCALSTORE_USE_CWD=true

# 测试时禁用全部平台，按需在本地开启
parser_disabled_platforms='["bilibili", "acfun", "youtube", "kuaishou", "twitter", "tiktok", "weibo", "xiaohongshu", "nga"]'
parser_bili_ck="<your_bili_cookie_here>"
parser_bili_video_codes='["avc", "av01"]'
parser_bili_video_quality=80
parser_ytb_ck="<your_ytb_cookie_here>"
parser_pixiv=https://pixivnow-lyart.vercel.app
parser_pixivR18=false
PARSER_PROXY=http://127.0.0.1:17890
