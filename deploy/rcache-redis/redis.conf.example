# 结果缓存 Redis 配置模板：cp 为 redis.conf 后编辑（含明文密码，勿入库/外传）
# <密码> 处填 `openssl rand -hex 32` 生成的值（只此一处，插件以 pcache 用户连接）

bind <本机内网可达地址>
port 6379
protected-mode yes

# 关闭默认用户，启用插件专用 ACL 用户：
# 只允许访问 pcache:* 键与所需命令（与"半可信输入"威胁模型一致）
user default off
user pcache on >密码 ~pcache:* +@connection +get +set +setex +del +ttl +eval

rename-command FLUSHALL ""
rename-command FLUSHDB ""

maxmemory 256mb
maxmemory-policy volatile-lru
appendonly no
