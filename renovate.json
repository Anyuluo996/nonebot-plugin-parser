{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Shanghai",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageTopic": "{{depName}}",
  "prHourlyLimit": 10,
  "separateMajorMinor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": []
  },
  "pip_requirements": { "enabled": false },
  "packageRules": [
    {
      "description": "GitHub Actions 工作流依赖合并为一个 PR（major/minor/patch 不拆分）",
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Python 运行时依赖 + 构建后端合并为一个 PR",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependencies", "build-system"],
      "groupName": "python runtime"
    },
    {
      "description": "dev/extras/test 开发依赖合并为一个 PR",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dev-dependencies", "optional-dependencies", "dependency-groups"],
      "groupName": "python dev"
    },
    {
      "description": "nonebug 走 git source (rev=master)，无法按 digest 跟踪更新，关闭其 PR 避免持续 Errored",
      "matchPackageNames": ["nonebug"],
      "enabled": false
    }
  ]
}
